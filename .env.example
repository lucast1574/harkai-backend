PORT=8080
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=harkai
CORS_ORIGINS=https://harkai.lat,https://www.harkai.lat,https://panel.harkai.lat

S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=harkai-local-api
S3_SECRET_KEY=local-api-development-only-password
S3_BUCKET=harkai-photos
S3_USE_SSL=false

# Optional Google identity; data and roles remain in Go
GOOGLE_PROJECT_ID=harkai-acceso
# Both worker values required together; keep the worker private
MEDIA_WORKER_URL=
MEDIA_WORKER_KEY=

# Optional private FCM send-only service account, base64 JSON; never a build arg
FCM_SERVICE_ACCOUNT_BASE64=
